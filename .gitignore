# Root .gitignore for E-commerce Project

# Environment variables (CRITICAL - NEVER COMMIT!)
.env
.env.local
.env.production
.env.*.local
backend/.env
frontend/.env

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Build outputs
dist/
build/
*.tsbuildinfo
.next/
out/

# Testing
coverage/
.nyc_output/

# Uploads (local files - not needed with Cloudinary)
backend/uploads/
uploads/

# Sensitive files
cloudinary-credentials.txt
credentials.json
firebase-service-account.json
*-firebase-adminsdk-*.json

# Temporary files
*.tmp
*.temp
.cache/

# Package manager
.pnpm-store/
.yarn/
.npm/
